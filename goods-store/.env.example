DATABASE_URL=postgresql://goods:REPLACE_WITH_UNIQUE_PASSWORD@127.0.0.1:55439/goods_medusa
APP_ORIGIN=http://127.0.0.1:8790
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
MEDUSA_PUBLISHABLE_KEY=REPLACE_WITH_GOODS_CHANNEL_PUBLISHABLE_KEY
# true for HTTPS, false only for loopback HTTP testing
COOKIE_SECURE=false

# Social OAuth preparation only. Server secrets; never use NEXT_PUBLIC_ prefixes.
# Credentials do not enable login until provider adapters and identity tests are released.
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_KAKAO_CLIENT_ID=
SOCIAL_KAKAO_CLIENT_SECRET=
SOCIAL_NAVER_CLIENT_ID=
SOCIAL_NAVER_CLIENT_SECRET=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_APPLE_CLIENT_ID=
SOCIAL_APPLE_TEAM_ID=
SOCIAL_APPLE_KEY_ID=
# Absolute path to a private .p8 key mounted as a read-only secret; not a public asset.
SOCIAL_APPLE_PRIVATE_KEY_PATH=
# Enable only after the matching private Medusa Kakao provider is configured.
KAKAO_ENABLED=false
