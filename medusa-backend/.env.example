DATABASE_URL=postgresql://goods:REPLACE_WITH_UNIQUE_PASSWORD@127.0.0.1:55439/goods_medusa
REDIS_URL=redis://127.0.0.1:56379
STORE_CORS=http://127.0.0.1:8790
ADMIN_CORS=http://127.0.0.1:9000
AUTH_CORS=http://127.0.0.1:8790,http://127.0.0.1:9000
JWT_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
COOKIE_SECRET=REPLACE_WITH_ANOTHER_32_OR_MORE_RANDOM_SECRET
BOOTSTRAP_ADMIN_EMAIL=operator@example.test
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_16_PLUS_CHARACTER_PASSWORD

# false only for loopback/private Docker network; use TLS for remote DB
DATABASE_SSL=false
# Set true ONLY for loopback HTTP demo; production HTTPS must keep false
ALLOW_LOCAL_HTTP=false

# Public URL for local demo image uploads. Match the browser-visible backend.
FILE_PUBLIC_URL=http://127.0.0.1:9000/static

# Kakao customer login (server only)
KAKAO_ENABLED=false
SOCIAL_KAKAO_CLIENT_ID=
SOCIAL_KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=https://new.thewhot.com/api/auth/social/kakao/callback
